; Engine configuration file.
; Edit through Godot where possible.

config_version=5

[application]

config/name="Cradles of Civilization — Port Prototype"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=960
window/size/viewport_height=640
window/size/window_width_override=960
window/size/window_height_override=640
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="CradlesOfCivilization"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.051, 0.075, 1)
